---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

import pet1 from '../images/image-1.jpg';
import pet2 from '../images/image-2.jpg';
import pet3 from '../images/pluto.jpg';
import pet4 from '../images/pancake.jpg';
import pet5 from '../images/minnie.jpg';
import pet6 from '../images/java.jpg';
import pet7 from '../images/image-7.jpg';
import pet8 from '../images/chloe.jpg';
import pet9 from '../images/image-9.jpg';
import pet10 from '../images/image-10.jpg';

const pets = [
	{
		name: '??',
		url: pet1,
	},
	{
		name: '??',
		url: pet2,
	},
	{
		name: 'pluto',
		url: pet3,
	},
	{
		name: 'pancake',
		url: pet4,
	},
	{
		name: 'minnie',
		url: pet5,
	},
	{
		name: 'java',
		url: pet6,
	},
	{
		name: '??',
		url: pet7,
	},
	{
		name: 'chloe',
		url: pet8,
	},
	{
		name: '??',
		url: pet9,
	},
	{
		name: '??',
		url: pet10,
	},
];

const batches = [];
for (let i = 0; i < pets.length; i += 5) {
	batches.push(pets.slice(i, i + 5));
}
---

<Layout>
	<div class="w-full bg-red min-h-screen pattern">
		<div class="w-full max-w-600 mx-auto px-8 md:px-20 xl:px-0 py-12 xl:py-24">
			<!-- Mobile Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-y-16 xl:hidden xl:invisible">
				{pets.map((pet: { name: string; url: ImageMetadata }) => <Card data={pet} />)}
			</div>
			<!-- Desktop Grid -->
			<div class="w-full max-xl:hidden max-xl:invisible space-y-12">
				{
					batches.map((batch: any[]) => {
						return (
							<div
								class:list={['w-full xl:last:pb-40 batch', batch.length < 4 ? 'xl:pb-28' : 'xl:pb-40']}
							>
								<div class="w-full flex flex-row items-end justify-between pl-40 2xl:pl-80 relative">
									{batch.slice(0, 3).map((pet, index) => (
										<div
											class:list={[
												index === 0 && 'w-92',
												index === 1 &&
													'w-52 absolute left-1/2 bottom-0 -translate-x-20 translate-y-28',
												index === 2 && 'w-105',
											]}
										>
											<Card data={pet} />
										</div>
									))}
								</div>
								{batch.length > 3 && (
									<div class="flex flex-row justify-between pr-96 gap-32 2xl:gap-64 mt-12 2xl:-mt-12">
										{batch.slice(3).map((pet, index) => (
											<div
												class:list={[
													index === 0 && 'w-72',
													index === 1 && 'w-72 translate-y-40',
												]}
											>
												<Card data={pet} />
											</div>
										))}
									</div>
								)}
							</div>
						);
					})
				}
			</div>
		</div>
	</div>
</Layout>
